#!/usr/bin/env bash

source_up_if_exists

# The dev shell contains narrenhaus built by gonixgo, so reload it (and
# rebuild narrenhaus) whenever the Go sources change. watch_dir covers
# files added later too; Nix only sees files that git tracks, so `git add`
# new ones.
watch_file go.mod go.sum

# Every package directory. One that does not exist yet is left out, since
# watch_dir fails on it; it is watched from the next reload on.
for dir in \
  cmd \
  decompress \
  e2e \
  httpd \
  nar \
  narinfo \
  nartree \
  nix32 \
  nixconf \
  packcache \
  refs \
  remote \
  testserver \
  upload; do
  if [ -d "$dir" ]; then
    watch_dir "$dir"
  fi
done

# Evaluating a gonixgo package runs `gonixgo resolve` through builtins.exec.
use flake . --option allow-unsafe-native-code-during-evaluation true
